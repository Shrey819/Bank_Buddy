-- HCLTech Future Ready AI Engineer Hackathon
-- AI-Powered Daily Banking Assistant — PostgreSQL demo seed
-- All records are fictional. Do not use for real banking.
-- Run in a dedicated demo database, e.g. psql -d banking_demo -f banking_demo.sql

BEGIN;

DROP TABLE IF EXISTS audit_logs CASCADE;
DROP TABLE IF EXISTS fraud_disputes CASCADE;
DROP TABLE IF EXISTS card_replacement_requests CASCADE;
DROP TABLE IF EXISTS personalized_offers CASCADE;
DROP TABLE IF EXISTS scheduled_payments CASCADE;
DROP TABLE IF EXISTS loan_emis CASCADE;
DROP TABLE IF EXISTS loans CASCADE;
DROP TABLE IF EXISTS credit_cards CASCADE;
DROP TABLE IF EXISTS accounts CASCADE;
DROP TABLE IF EXISTS transactions CASCADE;
DROP TABLE IF EXISTS bills CASCADE;
DROP TABLE IF EXISTS customers CASCADE;

CREATE TABLE customers (
    customer_id       VARCHAR(20) PRIMARY KEY,
    full_name         VARCHAR(100) NOT NULL,
    email             VARCHAR(150) UNIQUE NOT NULL,
    phone             VARCHAR(20),
    date_of_birth     DATE,
    city              VARCHAR(80),
    preferred_language VARCHAR(30) DEFAULT 'English',
    created_at        TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    is_active         BOOLEAN NOT NULL DEFAULT TRUE
);

CREATE TABLE accounts (
    account_id        VARCHAR(20) PRIMARY KEY,
    customer_id       VARCHAR(20) NOT NULL REFERENCES customers(customer_id),
    account_number    VARCHAR(30) UNIQUE NOT NULL, -- fictional masked demo number
    account_type      VARCHAR(30) NOT NULL CHECK (account_type IN ('savings','current')),
    currency          CHAR(3) NOT NULL DEFAULT 'INR',
    available_balance NUMERIC(14,2) NOT NULL CHECK (available_balance >= 0),
    ledger_balance    NUMERIC(14,2) NOT NULL CHECK (ledger_balance >= 0),
    status            VARCHAR(20) NOT NULL DEFAULT 'active'
                      CHECK (status IN ('active','frozen','closed')),
    opened_on         DATE NOT NULL
);

CREATE TABLE transactions (
    transaction_id   VARCHAR(30) PRIMARY KEY,
    account_id       VARCHAR(20) NOT NULL REFERENCES accounts(account_id),
    customer_id      VARCHAR(20) NOT NULL REFERENCES customers(customer_id),
    transaction_ts   TIMESTAMPTZ NOT NULL,
    merchant         VARCHAR(120) NOT NULL,
    description      TEXT,
    amount           NUMERIC(14,2) NOT NULL CHECK (amount > 0),
    direction        VARCHAR(10) NOT NULL CHECK (direction IN ('debit','credit')),
    category         VARCHAR(40) NOT NULL,
    payment_method   VARCHAR(30) NOT NULL
                     CHECK (payment_method IN ('UPI','NEFT','IMPS','RTGS','Debit Card','Credit Card',
                                               'ATM','Net Banking','Wallet','Cash','Auto-debit')),
    transaction_type VARCHAR(35) NOT NULL
                     CHECK (transaction_type IN ('purchase','upi_transfer','bank_transfer','atm_withdrawal',
                                                  'cash_deposit','cash_withdrawal','bill_payment','emi_payment',
                                                  'salary_credit','refund','reversal','card_payment',
                                                  'subscription','fee','interest_credit','other')),
    status           VARCHAR(20) NOT NULL CHECK (status IN ('successful','pending','failed','reversed')),
    reference_number VARCHAR(50) UNIQUE NOT NULL,
    upi_id           VARCHAR(100),
    card_id          VARCHAR(20),
    is_suspicious    BOOLEAN NOT NULL DEFAULT FALSE
);

CREATE INDEX idx_transactions_customer_ts ON transactions(customer_id, transaction_ts DESC);
CREATE INDEX idx_transactions_account_ts ON transactions(account_id, transaction_ts DESC);
CREATE INDEX idx_transactions_category ON transactions(customer_id, category);

CREATE TABLE bills (
    bill_id          VARCHAR(20) PRIMARY KEY,
    customer_id      VARCHAR(20) NOT NULL REFERENCES customers(customer_id),
    biller_name      VARCHAR(120) NOT NULL,
    bill_type        VARCHAR(40) NOT NULL,
    amount_due       NUMERIC(14,2) NOT NULL CHECK (amount_due >= 0),
    due_date         DATE NOT NULL,
    status           VARCHAR(20) NOT NULL CHECK (status IN ('upcoming','paid','overdue','cancelled')),
    autopay_enabled BOOLEAN NOT NULL DEFAULT FALSE,
    account_id       VARCHAR(20) REFERENCES accounts(account_id)
);

CREATE TABLE credit_cards (
    card_id             VARCHAR(20) PRIMARY KEY,
    customer_id         VARCHAR(20) NOT NULL REFERENCES customers(customer_id),
    account_id          VARCHAR(20) REFERENCES accounts(account_id),
    masked_card_number  VARCHAR(25) NOT NULL,
    card_network        VARCHAR(20) NOT NULL,
    credit_limit        NUMERIC(14,2) NOT NULL CHECK (credit_limit > 0),
    outstanding_amount  NUMERIC(14,2) NOT NULL CHECK (outstanding_amount >= 0),
    minimum_due         NUMERIC(14,2) NOT NULL CHECK (minimum_due >= 0),
    statement_due_date  DATE NOT NULL,
    status              VARCHAR(20) NOT NULL CHECK (status IN ('active','inactive','blocked','expired')),
    reward_points       INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE debit_cards (
    card_id             VARCHAR(20) PRIMARY KEY,
    customer_id         VARCHAR(20) NOT NULL REFERENCES customers(customer_id),
    account_id          VARCHAR(20) NOT NULL REFERENCES accounts(account_id),
    masked_card_number  VARCHAR(25) NOT NULL,
    card_network        VARCHAR(20) NOT NULL,
    daily_atm_limit     NUMERIC(14,2) NOT NULL CHECK (daily_atm_limit >= 0),
    daily_purchase_limit NUMERIC(14,2) NOT NULL CHECK (daily_purchase_limit >= 0),
    status              VARCHAR(20) NOT NULL CHECK (status IN ('active','inactive','blocked','expired')),
    issued_on           DATE NOT NULL,
    expires_on          DATE NOT NULL,
    CHECK (expires_on > issued_on)
);

CREATE TABLE card_status_history (
    history_id      BIGSERIAL PRIMARY KEY,
    card_id         VARCHAR(20) NOT NULL,
    card_type       VARCHAR(10) NOT NULL CHECK (card_type IN ('debit','credit')),
    customer_id     VARCHAR(20) NOT NULL REFERENCES customers(customer_id),
    old_status      VARCHAR(20) NOT NULL,
    new_status      VARCHAR(20) NOT NULL,
    reason          TEXT,
    confirmation_ref VARCHAR(50) UNIQUE NOT NULL,
    changed_at      TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

CREATE TABLE loans (
    loan_id             VARCHAR(20) PRIMARY KEY,
    customer_id         VARCHAR(20) NOT NULL REFERENCES customers(customer_id),
    loan_type           VARCHAR(30) NOT NULL,
    principal_amount    NUMERIC(14,2) NOT NULL CHECK (principal_amount > 0),
    outstanding_balance NUMERIC(14,2) NOT NULL CHECK (outstanding_balance >= 0),
    annual_interest_pct NUMERIC(5,2) NOT NULL CHECK (annual_interest_pct >= 0),
    emi_amount          NUMERIC(14,2) NOT NULL CHECK (emi_amount >= 0),
    next_emi_date       DATE NOT NULL,
    status              VARCHAR(20) NOT NULL CHECK (status IN ('active','closed','overdue'))
);

CREATE TABLE loan_emis (
    emi_id          VARCHAR(20) PRIMARY KEY,
    loan_id         VARCHAR(20) NOT NULL REFERENCES loans(loan_id),
    due_date        DATE NOT NULL,
    amount          NUMERIC(14,2) NOT NULL CHECK (amount >= 0),
    principal_part  NUMERIC(14,2) NOT NULL CHECK (principal_part >= 0),
    interest_part   NUMERIC(14,2) NOT NULL CHECK (interest_part >= 0),
    status          VARCHAR(20) NOT NULL CHECK (status IN ('upcoming','paid','overdue'))
);

CREATE TABLE scheduled_payments (
    payment_id       VARCHAR(20) PRIMARY KEY,
    customer_id      VARCHAR(20) NOT NULL REFERENCES customers(customer_id),
    account_id       VARCHAR(20) NOT NULL REFERENCES accounts(account_id),
    payee_name       VARCHAR(120) NOT NULL,
    amount           NUMERIC(14,2) NOT NULL CHECK (amount > 0),
    scheduled_date   DATE NOT NULL,
    payment_method   VARCHAR(30) NOT NULL,
    status           VARCHAR(20) NOT NULL CHECK (status IN ('scheduled','completed','failed','cancelled')),
    reference_number VARCHAR(50) UNIQUE NOT NULL
);

CREATE TABLE personalized_offers (
    offer_id           VARCHAR(20) PRIMARY KEY,
    customer_id        VARCHAR(20) NOT NULL REFERENCES customers(customer_id),
    product_type       VARCHAR(40) NOT NULL,
    offer_name         VARCHAR(120) NOT NULL,
    indicative_amount  NUMERIC(14,2),
    annual_interest_pct NUMERIC(5,2),
    eligibility_status VARCHAR(30) NOT NULL CHECK (eligibility_status IN ('prequalified_demo','not_eligible_demo','requires_review')),
    valid_until        DATE NOT NULL,
    disclaimer         TEXT NOT NULL
);

CREATE TABLE card_replacement_requests (
    request_id       VARCHAR(20) PRIMARY KEY,
    customer_id      VARCHAR(20) NOT NULL REFERENCES customers(customer_id),
    card_id          VARCHAR(20) NOT NULL REFERENCES credit_cards(card_id),
    requested_at     TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    reason           VARCHAR(50) NOT NULL,
    status           VARCHAR(30) NOT NULL CHECK (status IN ('submitted_demo','pending_review','completed_demo','rejected_demo')),
    confirmation_ref VARCHAR(50) UNIQUE NOT NULL
);

CREATE TABLE fraud_disputes (
    dispute_id       VARCHAR(20) PRIMARY KEY,
    customer_id      VARCHAR(20) NOT NULL REFERENCES customers(customer_id),
    transaction_id   VARCHAR(30) NOT NULL REFERENCES transactions(transaction_id),
    reason           TEXT NOT NULL,
    status           VARCHAR(30) NOT NULL CHECK (status IN ('submitted_demo','pending_review','resolved_demo','rejected_demo')),
    created_at       TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    confirmation_ref VARCHAR(50) UNIQUE NOT NULL,
    human_review_required BOOLEAN NOT NULL DEFAULT TRUE
);

CREATE TABLE audit_logs (
    audit_id       BIGSERIAL PRIMARY KEY,
    trace_id       VARCHAR(40) NOT NULL,
    customer_id    VARCHAR(20) REFERENCES customers(customer_id),
    action         VARCHAR(100) NOT NULL,
    tools_invoked  TEXT[] NOT NULL DEFAULT '{}',
    outcome        VARCHAR(40) NOT NULL,
    details        JSONB NOT NULL DEFAULT '{}'::jsonb,
    created_at     TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

